# IRIS MCP Server - Configuração
# Edite com suas credenciais do IRIS

# URL do IRIS (use o IP do servidor ou localhost se no mesmo host)
# Como o IRIS está em 8443 no mesmo servidor, use:
IRIS_URL=https://localhost:8443

# API Key do IRIS (obtenha em: IRIS > My Settings > API Key)
IRIS_API_KEY=your_api_key_here

# Verificação SSL (false para certificados auto-assinados)
IRIS_VERIFY_SSL=false
