# DFIR-IRIS MCP Server Configuration
# Copy this file to .env and fill in your values

# IRIS Connection (required)
IRIS_URL=https://iriswebapp_nginx:8443
IRIS_API_KEY=your_iris_api_key_here

# SSL Verification (set to false for self-signed certs / Docker internal)
IRIS_VERIFY_SSL=false

# Logging
LOG_LEVEL=INFO